# Google AI Studio API Key — free at https://aistudio.google.com
# Gemini 2.0 Flash: 1,500 req/day · 15 RPM · 1M TPM (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token — needed for the GitHub MCP server
# Create at: https://github.com/settings/tokens (scopes: repo, read:org)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
