# ── Primary extraction model ─────────────────────────────────────────────────
# Anthropic Claude Haiku 4.5 — required for EXTRACTION_MODEL=claude-haiku-4-5-*
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Insights model (optional — Claude fallback is used if absent) ─────────────
# NVIDIA NIM API key for Llama 3.3 70B Instruct (OpenAI-compatible endpoint)
# Free tier available at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Gemini (optional — only needed if switching EXTRACTION_MODEL to gemini-*) ──
# Google AI Studio free tier: 500 RPD / 15 RPM (gemini-2.5-flash-lite)
# Get a key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── GitHub Personal Access Token ─────────────────────────────────────────────
# Required for the GitHub MCP server only
# Create at: https://github.com/settings/tokens (scopes: repo, read:org)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
